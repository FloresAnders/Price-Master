{
  "manifest_version": 3,
  "name": "LeerRegistro",
  "version": "1.0.0",
  "description": "Carga los totales de BCR, Contica y Tiempos en el cierre diario de Fondo General.",
  "permissions": ["tabs", "scripting"],
  "host_permissions": [
    "https://www.bcrcorresponsal.bancobcr.com/BCRCorresponsalesExterno/*",
    "https://contica.app/app/modules/cierre/*",
    "https://www.timemaster.es/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bcrcorresponsal.bancobcr.com/BCRCorresponsalesExterno/*"
      ],
      "js": ["core.js", "bcr-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://contica.app/app/modules/cierre/*"],
      "js": ["core.js", "contica-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.timemaster.es/*"],
      "js": ["core.js", "timemaster-content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
