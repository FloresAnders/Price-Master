{
  "manifest_version": 3,
  "name": "TimeMaster - BCR Tucán",
  "version": "1.0.0",
  "description": "Detecta comprobantes impresos de BCR Tucán y sincroniza su hora y monto con TimeMaster.",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://www.bcrcorresponsal.bancobcr.com/BCRCorresponsalesExterno/Paginas/*",
    "https://timemaster.es/*",
    "https://www.timemaster.es/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.bcrcorresponsal.bancobcr.com/BCRCorresponsalesExterno/Paginas/*"],
      "js": ["receipt.js"],
      "run_at": "document_start",
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "Comprobantes BCR Tucán",
    "default_popup": "popup.html"
  }
}
