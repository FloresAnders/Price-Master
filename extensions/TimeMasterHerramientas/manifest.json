{
  "manifest_version": 3,
  "name": "TimeMaster Herramientas",
  "version": "1.2.0",
  "description": "Atajos para Contica, Gente Crystal y formato configurable por líneas de impresión.",
  "permissions": ["storage"],
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://contica.app/app/modules/punto_de_venta/*"],
      "js": [
        "settings-core.js",
        "cambiotab-core.js",
        "cerrarimpresioncontica-core.js",
        "dividirefectivo-core.js",
        "moverpago-core.js",
        "contica-content.js"
      ],
      "css": ["contica-content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gentecrystal.net/print_pagos.php*"],
      "js": ["resaltartiquete-print-gate.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://gentecrystal.net/print_pagos.php*"],
      "js": [
        "settings-core.js",
        "lineasimpresion-core.js",
        "lineasimpresion-content-core.js",
        "resaltartiquete-content.js"
      ],
      "css": ["resaltartiquete.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://gentecrystal.net/controllers/sales/SalesController.php*"],
      "js": [
        "settings-core.js",
        "sumatiempos-core.js",
        "moverenter-core.js",
        "ingresarventa-core.js",
        "gentecrystal-content.js"
      ],
      "css": ["gentecrystal-content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.bcrcorresponsal.bancobcr.com/*"],
      "js": ["impresioncompleta-print-gate.js"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.bcrcorresponsal.bancobcr.com/*"],
      "js": [
        "settings-core.js",
        "lineasimpresion-core.js",
        "lineasimpresion-content-core.js",
        "impresioncompleta-content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ]
}
