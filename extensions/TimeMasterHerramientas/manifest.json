{
  "manifest_version": 3,
  "name": "TimeMaster Herramientas",
  "version": "1.0.0",
  "description": "Atajos de Contica, suma de tiempos e impresión automática para Gente Crystal.",
  "permissions": ["storage"],
  "icons": {
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://contica.app/app/modules/punto_de_venta/*"],
      "js": ["settings-core.js", "cambiotab-core.js", "contica-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gentecrystal.net/controllers/sales/SalesController.php*"],
      "js": [
        "settings-core.js",
        "sumatiempos-core.js",
        "moverenter-core.js",
        "gentecrystal-content.js"
      ],
      "css": ["gentecrystal-content.css"],
      "run_at": "document_idle"
    }
  ]
}
