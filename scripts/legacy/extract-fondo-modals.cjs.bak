// Reemplaza el bloque de modales en FondoSection.tsx por <FondoSectionModals />.
const fs = require("fs");
const path = require("path");

const filePath = path.join(
  __dirname,
  "..",
  "..",
  "src",
  "app",
  "fondogeneral",
  "components",
  "layout",
  "FondoSection.tsx",
);

const lines = fs.readFileSync(filePath, "utf8").split(/\r?\n/);

// Locate modal block: <AuditHistoryModal ... through ... onDeleteLatestClosing={...} />
let start = -1;
for (let i = 0; i < lines.length; i++) {
  if (lines[i].includes("<AuditHistoryModal")) {
    start = i;
    break;
  }
}
if (start === -1) throw new Error("No se encontro <AuditHistoryModal");

// end = the line before `    </div>` closing the root container (last `      />`)
let end = -1;
for (let i = lines.length - 1; i > start; i--) {
  if (lines[i].trim() === "</div>" && lines[i - 1].trim() === "/>") {
    end = i;
    break;
  }
}
if (end === -1) throw new Error("No se encontro el cierre del bloque de modales");

const modalBlock = lines.slice(start, end);
console.log(
  `Bloque modales: lineas ${start + 1}..${end} (${modalBlock.length} lineas)`,
);

const replacement = [
  '      <FondoSectionModals',
  '        auditModalOpen={auditModalOpen}',
  '        onCloseAuditModal={() => setAuditModalOpen(false)}',
  '        auditModalData={auditModalData}',
  '        dateTimeFormatter={dateTimeFormatter}',
  '        formatByCurrency={formatByCurrency}',
  '        providersMap={providersMap}',
  '        dailyClosingModalOpen={dailyClosingModalOpen}',
  '        editingDailyClosingId={editingDailyClosingId}',
  '        dailyClosingInitialValues={dailyClosingInitialValues}',
  '        onCloseDailyClosing={handleCloseDailyClosing}',
  '        onConfirmDailyClosing={handleConfirmDailyClosing}',
  '        onDailyClosingTurnoChange={setDailyClosingTurno}',
  '        dailyClosingTurno={dailyClosingTurno}',
  '        onShowDailyClosingHistory={() => {',
  '          setDailyClosingHistoryRange("today");',
  '          setDailyClosingHistoryOpen(true);',
  '        }}',
  '        employeeOptions={employeeOptions}',
  '        employeesLoading={employeesLoading}',
  '        currentBalanceCRC={currentBalanceCRC}',
  '        currentBalanceUSD={currentBalanceUSD}',
  '        requireSingleClosingReason={dailyClosingSingleReasonRequired && !editingDailyClosingId && activeEmpresaForCompany?.unicoCierre !== true}',
  '        managerReadonly={!editingDailyClosingId}',
  '        requireTurnoSelection={!editingDailyClosingId && canBypassClosingWindows}',
  '        cierreFondoVentasMinutesBeforeEnd={cierreFondoVentasMinutesBeforeEnd}',
  '        cierreFondoVentasMinutesAfterEnd={cierreFondoVentasMinutesAfterEnd}',
  '        previousReconciliation={dailyClosingTurno === "N" ? dailyClosingDayD?.reconciliation : null}',
  '        cumulativeContica={dailyClosingTurno === "N" ? {',
  '          r08: dailyClosingDayD?.reconciliation?.calculated.cumulativeR08 ?? 0,',
  '          t11: dailyClosingDayD?.reconciliation?.calculated.cumulativeT11 ?? 0,',
  '        } : { r08: 0, t11: 0 }}',
  '        systemVerificationEnabled={activeEmpresaForCompany?.verificacionSistemas !== false}',
  '        dailyClosingSummaryRecord={dailyClosingSummaryRecord}',
  '        onCloseDailyClosingSummary={() => setDailyClosingSummaryRecord(null)}',
  '        closingPaymentModalOpen={closingPaymentModalOpen}',
  '        closingPaymentTarget={closingPaymentTarget}',
  '        providerName={closingPaymentTarget ? providers.find((provider) => provider.code === closingPaymentTarget.providerCode)?.name || closingPaymentTarget.providerCode : ""}',
  '        closingPaymentAmount={closingPaymentAmount}',
  '        closingPaymentNotes={closingPaymentNotes}',
  '        closingPaymentManager2={closingPaymentManager2}',
  '        closingPaymentCreditNoteIds={closingPaymentCreditNoteIds}',
  '        closingPaymentSubmitting={closingPaymentSubmitting}',
  '        onCloseClosingPaymentModal={closeClosingInvoicePaymentModal}',
  '        onPaymentAmountChange={setClosingPaymentAmount}',
  '        onPaymentNotesChange={setClosingPaymentNotes}',
  '        onPaymentManager2Change={setClosingPaymentManager2}',
  '        onSubmitPartialPayment={() => void submitClosingInvoicePayment("partial")}',
  '        onSubmitFullPayment={() => void submitClosingInvoicePayment("full")}',
  '        closingPaymentAvailableCreditNotes={closingPaymentAvailableCreditNotes}',
  '        closingPaymentCreditNotesTotal={closingPaymentCreditNotesTotal}',
  '        onToggleClosingPaymentCreditNote={(id) => {',
  '          setClosingPaymentCreditNoteIds((prev) =>',
  '            prev.includes(id)',
  '              ? prev.filter((item) => item !== id)',
  '              : [...prev, id],',
  '          );',
  '        }}',
  '        confirmOpenCreateMovement={confirmOpenCreateMovement}',
  '        onConfirmOpenCreateMovement={confirmOpenCreateMovementNow}',
  '        onCancelOpenCreateMovement={cancelOpenCreateMovement}',
  '        company={company}',
  '        accountKey={accountKey}',
  '        missingShiftModalOpen={missingShiftModalOpen}',
  '        missingShiftExpectedShift={missingShiftExpectedShift}',
  '        missingShiftDateKey={missingShiftDateKey}',
  '        onCloseMissingShift={() => setMissingShiftModalOpen(false)}',
  '        onGoToControlHorario={() => {',
  '          setMissingShiftModalOpen(false);',
  '          setMovementModalOpen(false);',
  '          window.location.hash = "#controlhorario";',
  '        }}',
  '        confirmPhysicalCountOpen={confirmPhysicalCountOpen}',
  '        handleCancelPhysicalCount={handleCancelPhysicalCount}',
  '        handleOpenCashOpening={handleOpenCashOpening}',
  '        pendingCierreModalOpen={pendingCierreModalOpen}',
  '        closePendingCierreModal={closePendingCierreModal}',
  '        confirmDeleteEntry={confirmDeleteEntry}',
  '        confirmDeleteMovement={confirmDeleteMovement}',
  '        cancelDeleteMovement={cancelDeleteMovement}',
  '        cashOpeningModalOpen={cashOpeningModalOpen}',
  '        cashOpeningInitialValues={cashOpeningInitialValues}',
  '        cashOpeningEditingEntry={cashOpeningEditingEntry}',
  '        onCloseCashOpening={handleCloseCashOpening}',
  '        onConfirmCashOpening={handleConfirmCashOpening}',
  '        managerReadonlyCashOpening={isRegularUser}',
  '        cashOpeningDraftStorageKey={`fondogeneral-cash-opening-modal-draft:${company || "default"}:${accountKey}`}',
  '        pendingZeroAmountCreditNoteModalOpen={pendingZeroAmountCreditNoteModalOpen}',
  '        pendingZeroAmountCreditNotes={pendingZeroAmountCreditNotes}',
  '        onClosePendingZeroAmount={() => {',
  '          setPendingZeroAmountCreditNoteModalOpen(false);',
  '          window.location.hash = "#facturas";',
  '        }}',
  '        negativeBalanceModal={negativeBalanceModal}',
  '        onCloseNegativeBalance={() =>',
  '          setNegativeBalanceModal({ open: false, amount: 0, currency: "CRC", resultingNegativeAmount: 0 })',
  '        }',
  '        dailyClosingHistoryOpen={dailyClosingHistoryOpen}',
  '        onCloseDailyClosingHistory={() => setDailyClosingHistoryOpen(false)}',
  '        closingsAreLoading={closingsAreLoading}',
  '        dailyClosings={dailyClosings}',
  '        dailyClosingHistoryRange={dailyClosingHistoryRange}',
  '        onQuickRangeChange={setDailyClosingHistoryRange}',
  '        dailyClosingDateFormatter={dailyClosingDateFormatter}',
  '        buildBreakdownLines={buildBreakdownLines}',
  '        formatDailyClosingDiff={formatDailyClosingDiff}',
  '        getDailyClosingDiffClass={getDailyClosingDiffClass}',
  '        fondoEntries={fondoEntries}',
  '        isAutoAdjustmentProvider={isAutoAdjustmentProvider}',
  '        expandedClosings={expandedClosings}',
  '        setExpandedClosings={setExpandedClosings}',
  '        canDeleteLatestClosing={Boolean(isSuperAdminUser) && accountKey === "FondoGeneral" && Boolean((company || "").trim()) && dailyClosings.length > 0}',
  '        latestClosingLabel={latestDailyClosingLabel}',
  '        onDeleteLatestClosing={handleDeleteLatestDailyClosing}',
  '      />',
];

const newLines = [
  ...lines.slice(0, start),
  ...replacement,
  ...lines.slice(end),
];

fs.writeFileSync(filePath, newLines.join("\n"), "utf8");
console.log(`Reemplazo OK. Nuevo total lineas: ${newLines.length}`);
