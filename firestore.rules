rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ========================================================================
    // MODELO DE ANUNCIOS DEL SISTEMA
    // ========================================================================
    // systemAnnouncements/{id}: inventario administrativo privado. Campos
    // requeridos: title, detail, type, active, startsAt, endsAt, allowDismiss,
    // priority, scope, archived, version, createdAt, updatedAt, createdBy,
    // updatedBy.
    // publishedSystemAnnouncements/{id}: proyeccion segura para usuarios
    // autenticados. Campos requeridos: title, detail, type, startsAt, endsAt,
    // allowDismiss, priority, scope, version, publishedAt.
    // Ambos documentos se mantienen en un mismo batch y usan Timestamp para
    // todas las fechas. La proyeccion no contiene UIDs de auditoria.
    // ========================================================================
    // ========================================================================
    // VENTANA DE COMPATIBILIDAD — migracion al puente de Firebase Auth
    // ========================================================================
    // Las reglas exigen sesion de Firebase (custom token via
    // /api/auth/firebase-token + signInWithCustomToken). Para que el despliegue
    // unico (push) no corte a nadie mientras la nueva version se propaga,
    // isSignedIn() se mantiene ESTRICTO (request.auth != null) y cada `allow`
    // acepta ademas clientes SIN firmar hasta la fecha de corte, con la misma
    // apertura que tenia el catch-all anterior (que fue eliminado).
    //
    // La fecha de corte debe ser SIEMPRE anterior a 2027-07-09 (techo del
    // catch-all historico). Tras la fecha, estas clausulas quedan inactivas y
    // pueden borrarse. NO re-activar acceso anonimo despues del corte.
    // ========================================================================
    function isCompatWindow() {
      return request.auth == null &&
        request.time < timestamp.date(2026, 10, 1);
    }

    function isAppSession() {
      return request.auth != null &&
        request.auth.token.get('authPurpose', '') != 'sinpe-realtime';
    }

    function hasActiveMaintenanceBypass() {
      return request.auth.token.get('maintenanceBypassExpiresAt', 0) is int &&
        request.auth.token.get('maintenanceBypassExpiresAt', 0) > request.time.toMillis();
    }

    function isUserBlockedByMaintenance() {
      let maintenance = get(/databases/$(database)/documents/version/current)
        .data.get('maintenance', {});
      let global = maintenance.get('global', {});
      let activeCompanies = maintenance.get('activeCompanyIdentifiers', []);
      return request.auth.token.role == 'user' &&
        !hasActiveMaintenanceBypass() &&
        (
          global.get('enabled', false) == true ||
          (
            request.auth.token.get('ownercompanieNormalized', '') != '' &&
            request.auth.token.get('ownercompanieNormalized', '') in activeCompanies
          )
        );
    }

    function isSignedIn() {
      return isAppSession() && !isUserBlockedByMaintenance();
    }

    function isAdmin() {
      return isSignedIn() &&
        (request.auth.token.role == 'admin' || request.auth.token.role == 'superadmin');
    }

    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.role == 'superadmin';
    }

    function isValidFestivityConfig(data) {
      let title = data.title;
      let message = data.message;
      return data.enabled is bool &&
        title is string &&
        title.size() > 0 &&
        title.size() <= 80 &&
        message is string &&
        message.size() <= 200;
    }

    function isValidSeasonalEffects(data) {
      let festivities = data.festivities;
      return data.keys().hasOnly([
          'schemaVersion',
          'enabled',
          'festivities',
          'updatedAt',
          'updatedBy'
        ]) &&
        data.schemaVersion == 1 &&
        data.enabled is bool &&
        festivities is map &&
        festivities.keys().hasOnly([
          'new-year',
          'holy-thursday',
          'good-friday',
          'juan-santamaria',
          'workers-day',
          'nicoya',
          'virgen-angeles',
          'mothers-day',
          'afro-culture',
          'army-abolition',
          'christmas',
          'year-end'
        ]) &&
        isValidFestivityConfig(festivities['new-year']) &&
        isValidFestivityConfig(festivities['holy-thursday']) &&
        isValidFestivityConfig(festivities['good-friday']) &&
        isValidFestivityConfig(festivities['juan-santamaria']) &&
        isValidFestivityConfig(festivities['workers-day']) &&
        isValidFestivityConfig(festivities.nicoya) &&
        isValidFestivityConfig(festivities['virgen-angeles']) &&
        isValidFestivityConfig(festivities['mothers-day']) &&
        isValidFestivityConfig(festivities['afro-culture']) &&
        isValidFestivityConfig(festivities['army-abolition']) &&
        isValidFestivityConfig(festivities.christmas) &&
        isValidFestivityConfig(festivities['year-end']) &&
        data.updatedAt is timestamp &&
        data.updatedBy is string &&
        data.updatedBy.size() > 0 &&
        data.updatedBy.size() <= 128 &&
        data.updatedBy == request.auth.uid;
    }

    function isRegularAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function hasValidAnnouncementWindow(data) {
      return (data.startsAt == null || data.startsAt is timestamp) &&
        (data.endsAt == null || data.endsAt is timestamp) &&
        (
          data.startsAt == null ||
          data.endsAt == null ||
          data.endsAt > data.startsAt
        );
    }

    function isValidSystemAnnouncement(data) {
      return data.keys().hasOnly([
          'title',
          'detail',
          'type',
          'active',
          'startsAt',
          'endsAt',
          'allowDismiss',
          'priority',
          'scope',
          'archived',
          'version',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ]) &&
        data.keys().hasAll([
          'title',
          'detail',
          'type',
          'active',
          'startsAt',
          'endsAt',
          'allowDismiss',
          'priority',
          'scope',
          'archived',
          'version',
          'createdAt',
          'updatedAt',
          'createdBy',
          'updatedBy'
        ]) &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 100 &&
        data.detail is string &&
        data.detail.size() > 0 &&
        data.detail.size() <= 300 &&
        data.type is string &&
        data.type in ['info', 'maintenance', 'warning', 'new_feature'] &&
        data.active is bool &&
        data.allowDismiss is bool &&
        data.priority is int &&
        data.priority >= -1000 &&
        data.priority <= 1000 &&
        data.scope == 'global' &&
        data.archived is bool &&
        data.version is int &&
        data.version >= 1 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.createdBy is string &&
        data.createdBy.size() > 0 &&
        data.createdBy.size() <= 128 &&
        data.updatedBy is string &&
        data.updatedBy.size() > 0 &&
        data.updatedBy.size() <= 128 &&
        hasValidAnnouncementWindow(data);
    }

    function isValidPublishedSystemAnnouncement(data) {
      return data.keys().hasOnly([
          'title',
          'detail',
          'type',
          'startsAt',
          'endsAt',
          'allowDismiss',
          'priority',
          'scope',
          'version',
          'publishedAt'
        ]) &&
        data.keys().hasAll([
          'title',
          'detail',
          'type',
          'startsAt',
          'endsAt',
          'allowDismiss',
          'priority',
          'scope',
          'version',
          'publishedAt'
        ]) &&
        data.title is string &&
        data.title.size() > 0 &&
        data.title.size() <= 100 &&
        data.detail is string &&
        data.detail.size() > 0 &&
        data.detail.size() <= 300 &&
        data.type is string &&
        data.type in ['info', 'maintenance', 'warning', 'new_feature'] &&
        data.allowDismiss is bool &&
        data.priority is int &&
        data.priority >= -1000 &&
        data.priority <= 1000 &&
        data.scope == 'global' &&
        data.version is int &&
        data.version >= 1 &&
        data.publishedAt is timestamp &&
        hasValidAnnouncementWindow(data);
    }

    function publishedAnnouncementMatchesSource(announcementId, data) {
      let source = getAfter(
        /databases/$(database)/documents/systemAnnouncements/$(announcementId)
      ).data;
      return existsAfter(
          /databases/$(database)/documents/systemAnnouncements/$(announcementId)
        ) &&
        source.active == true &&
        source.archived == false &&
        data.title == source.title &&
        data.detail == source.detail &&
        data.type == source.type &&
        data.startsAt == source.startsAt &&
        data.endsAt == source.endsAt &&
        data.allowDismiss == source.allowDismiss &&
        data.priority == source.priority &&
        data.scope == source.scope &&
        data.version == source.version &&
        data.publishedAt == source.updatedAt;
    }

    function systemAnnouncementProjectionIsSynchronized(announcementId, data) {
      let publicPath = /databases/$(database)/documents/publishedSystemAnnouncements/$(announcementId);
      return (
          data.active == true &&
          data.archived == false &&
          existsAfter(publicPath) &&
          publishedAnnouncementMatchesSource(
            announcementId,
            getAfter(publicPath).data
          )
        ) ||
        (
          (data.active == false || data.archived == true) &&
          !existsAfter(publicPath)
        );
    }

    match /systemAnnouncements/{announcementId} {
      allow read: if isSuperAdmin();
      allow create: if isSuperAdmin() &&
        isValidSystemAnnouncement(request.resource.data) &&
        request.resource.data.version == 1 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.updatedBy == request.auth.uid &&
        systemAnnouncementProjectionIsSynchronized(
          announcementId,
          request.resource.data
        );
      allow update: if isSuperAdmin() &&
        isValidSystemAnnouncement(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.version == resource.data.version + 1 &&
        systemAnnouncementProjectionIsSynchronized(
          announcementId,
          request.resource.data
        );
      allow delete: if isSuperAdmin() &&
        !existsAfter(
          /databases/$(database)/documents/publishedSystemAnnouncements/$(announcementId)
        );
    }

    match /publishedSystemAnnouncements/{announcementId} {
      allow read: if isSignedIn();
      allow create, update: if isSuperAdmin() &&
        isValidPublishedSystemAnnouncement(request.resource.data) &&
        request.resource.data.publishedAt == request.time &&
        publishedAnnouncementMatchesSource(
          announcementId,
          request.resource.data
        );
      allow delete: if isSuperAdmin() &&
        (
          !existsAfter(
            /databases/$(database)/documents/systemAnnouncements/$(announcementId)
          ) ||
          getAfter(
            /databases/$(database)/documents/systemAnnouncements/$(announcementId)
          ).data.active == false ||
          getAfter(
            /databases/$(database)/documents/systemAnnouncements/$(announcementId)
          ).data.archived == true
        );
    }

    function hasAnotacionesPermission() {
      return isAdmin() ||
        (isSignedIn() && request.auth.token.permissions.anotaciones == true);
    }

    function hasTiemposPermission() {
      return isAdmin() ||
        (
          isSignedIn() &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid))
              .data.permissions.tiempos == true ||
            request.auth.token.tiempos == true ||
            (
              request.auth.token.permissions is map &&
              request.auth.token.permissions.tiempos == true
            )
          )
        );
    }

    function hasRegistroTiemposPermission() {
      return isAdmin() ||
        (
          isSignedIn() &&
          (
            get(/databases/$(database)/documents/users/$(request.auth.uid))
              .data.permissions.registroTiempos == true ||
            request.auth.token.registroTiempos == true ||
            (
              request.auth.token.permissions is map &&
              request.auth.token.permissions.registroTiempos == true
            )
          )
        );
    }

    function hasFondoGeneralPermission() {
      return isSuperAdmin() ||
        (
          isSignedIn() &&
          request.auth.token.get('permissions', {}) is map &&
          request.auth.token.get('permissions', {}).get('fondogeneral', false) == true
        );
    }

    function canReadSinpeRealtime(empresaId) {
      return request.auth != null &&
        request.auth.token.get('authPurpose', '') == 'sinpe-realtime' &&
        exists(/databases/$(database)/documents/sinpeRealtimeSessions/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/sinpeRealtimeSessions/$(request.auth.uid))
          .data.expiresAt > request.time &&
        get(/databases/$(database)/documents/sinpeRealtimeSessions/$(request.auth.uid))
          .data.empresaIds is list &&
        empresaId in get(/databases/$(database)/documents/sinpeRealtimeSessions/$(request.auth.uid))
          .data.empresaIds;
    }

    match /version/{documentId} {
      // El canal de versiones debe seguir visible para clientes viejos durante
      // la ventana: es lo que dispara su logout+recarga hacia el cliente nuevo.
      // Usuarios bloqueados necesitan leer este documento para mostrar la
      // pantalla de mantenimiento y reaccionar cuando se desactive.
      allow read: if isAppSession() || isCompatWindow();
      allow create: if isSignedIn() &&
        (isSuperAdmin() || !request.resource.data.keys().hasAny(['maintenance']));
      allow update: if isSignedIn() &&
        (isSuperAdmin() ||
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['maintenance']));
      allow delete: if isSuperAdmin();
    }

    function canAccessAnotacionScope(data) {
      return isSuperAdmin() ||
        (isRegularAdmin() &&
          data.keys().hasAny(['ownerId']) &&
          data.ownerId == request.auth.token.ownerId) ||
        (!isAdmin() &&
          data.keys().hasAny(['empresa']) &&
          data.empresa == request.auth.token.ownercompanie);
    }

    function isAnotacionPathConsistent(data, empresaId) {
      return data.keys().hasAny(['empresaId']) &&
        data.empresaId == empresaId;
    }

    // Colección de emails - solo escritura desde el cliente, lectura y actualización desde Functions
    match /emails/{emailId} {
      // Permitir crear documentos desde el cliente
      allow create: if isSignedIn();

      // Solo Functions puede actualizar el estado
      allow update: if false;

      // Solo lectura para administradores
      allow read: if request.auth != null && request.auth.token.role == 'admin';
    }

    match /closingTimeExtensions/{extensionId} {
      allow read: if isSignedIn() || isCompatWindow();
      allow create: if isSignedIn() ||
        (isCompatWindow() &&
          request.resource.data.status == 'pending');
      allow update: if isAdmin() ||
        (
          isSignedIn() &&
          (resource.data.status == 'pending' ||
            resource.data.status == 'rejected' ||
            resource.data.status == 'expired') &&
          request.resource.data.status == 'pending' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'company',
              'companyKey',
              'operationalDateKey',
              'turno',
              'extraMinutes',
              'status',
              'reason',
              'requestedBy',
              'createdAt',
              'updatedAt'
            ])
        ) ||
        (
          isSignedIn() &&
          (resource.data.status == 'approved' ||
            resource.data.status == 'rejected') &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['responseSeenAt'])
        ) ||
        (
          isSignedIn() &&
          resource.data.status == 'approved' &&
          request.resource.data.status == 'used' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'usedBy', 'usedAt'])
        );
      allow delete: if isAdmin();
    }

    match /pendingInvoiceDeletionRequests/{requestId} {
      allow read: if isSignedIn() || isCompatWindow();
      allow create: if isSignedIn() ||
        (isCompatWindow() &&
          request.resource.data.status == 'pending');
      allow update: if isAdmin() ||
        (
          isSignedIn() &&
          resource.data.status == 'rejected' &&
          request.resource.data.status == 'pending' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'company',
              'companyKey',
              'invoiceId',
              'invoiceNumber',
              'invoiceDocType',
              'paymentStatus',
              'amount',
              'currency',
              'providerCode',
              'manager',
              'status',
              'reason',
              'requestedBy',
              'createdAt',
              'updatedAt',
              'approvedBy',
              'approvedAt',
              'rejectedBy',
              'rejectedAt',
              'rejectionReason',
              'responseSeenAt'
            ])
        ) ||
        (
          isSignedIn() &&
          (resource.data.status == 'approved' ||
            resource.data.status == 'rejected') &&
          (resource.data.requestedBy == request.auth.token.email ||
            resource.data.requestedBy == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['responseSeenAt'])
        );
      allow delete: if isAdmin();
    }

    match /Facturas/{empresaId}/movements/{movementId} {
      allow read, create, update: if isSignedIn() || isCompatWindow();
      allow delete: if isAdmin();
    }

    match /anotaciones/{empresaId}/movements/{noteId} {
      allow read: if hasAnotacionesPermission() &&
        isAnotacionPathConsistent(resource.data, empresaId) &&
        canAccessAnotacionScope(resource.data);
      allow create: if hasAnotacionesPermission() &&
        isAnotacionPathConsistent(request.resource.data, empresaId) &&
        canAccessAnotacionScope(request.resource.data);
      allow update: if hasAnotacionesPermission() &&
        isAnotacionPathConsistent(resource.data, empresaId) &&
        isAnotacionPathConsistent(request.resource.data, empresaId) &&
        canAccessAnotacionScope(resource.data) &&
        canAccessAnotacionScope(request.resource.data);
      allow delete: if false;
    }

    function isRegistroTucanRecord() {
      return request.resource.data.keys().hasOnly([
          'empresaId',
          'empresa',
          'dateKey',
          'fecha',
          'hora',
          'saldoPaginaTucan',
          'saldoFondoTucan',
          'pagosHoy',
          'saldoSinpesRecibidos',
          'total',
          'motivo',
          'currency',
          'createdById',
          'createdByName',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'empresaId',
          'empresa',
          'dateKey',
          'fecha',
          'hora',
          'saldoPaginaTucan',
          'saldoFondoTucan',
          'pagosHoy',
          'saldoSinpesRecibidos',
          'total',
          'currency',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.empresa is string &&
        request.resource.data.dateKey is number &&
        request.resource.data.fecha is string &&
        request.resource.data.hora is string &&
        request.resource.data.saldoPaginaTucan is number &&
        request.resource.data.saldoFondoTucan is number &&
        request.resource.data.pagosHoy is number &&
        request.resource.data.saldoSinpesRecibidos is number &&
        request.resource.data.total is number &&
        request.resource.data.currency == 'CRC' &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        (!request.resource.data.keys().hasAny(['motivo']) ||
          request.resource.data.motivo is string) &&
        (!request.resource.data.keys().hasAny(['empresaId']) ||
          request.resource.data.empresaId is string) &&
        (!request.resource.data.keys().hasAny(['createdById']) ||
          request.resource.data.createdById is string) &&
        (!request.resource.data.keys().hasAny(['createdByName']) ||
          request.resource.data.createdByName is string);
    }

    function isRegistroTiemposRecord() {
      return request.resource.data.keys().hasOnly([
          'empresaId',
          'empresa',
          'dateKey',
          'fecha',
          'hora',
          'saldoPaginaTiempos',
          'saldoFondoTiempos',
          'pagosHoy',
          'saldoSinpesRecibidos',
          'total',
          'motivo',
          'currency',
          'createdById',
          'createdByName',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'empresaId',
          'empresa',
          'dateKey',
          'fecha',
          'hora',
          'saldoPaginaTiempos',
          'saldoFondoTiempos',
          'pagosHoy',
          'saldoSinpesRecibidos',
          'total',
          'currency',
          'createdAt',
          'updatedAt'
        ]) &&
        request.resource.data.empresa is string &&
        request.resource.data.dateKey is number &&
        request.resource.data.fecha is string &&
        request.resource.data.hora is string &&
        request.resource.data.saldoPaginaTiempos is number &&
        request.resource.data.saldoFondoTiempos is number &&
        request.resource.data.pagosHoy is number &&
        request.resource.data.saldoSinpesRecibidos is number &&
        request.resource.data.total is number &&
        request.resource.data.currency == 'CRC' &&
        request.resource.data.createdAt is timestamp &&
        request.resource.data.updatedAt is timestamp &&
        (!request.resource.data.keys().hasAny(['motivo']) ||
          request.resource.data.motivo is string) &&
        (!request.resource.data.keys().hasAny(['empresaId']) ||
          request.resource.data.empresaId is string) &&
        (!request.resource.data.keys().hasAny(['createdById']) ||
          (
            request.resource.data.createdById is string &&
            request.resource.data.createdById == request.auth.uid
          )) &&
        (!request.resource.data.keys().hasAny(['createdByName']) ||
          request.resource.data.createdByName is string);
    }

    match /registrotucan/{empresaId}/records/{recordId} {
      allow read: if isSignedIn() || isCompatWindow();
      allow create: if isSignedIn() ||
        (isCompatWindow() &&
          isRegistroTucanRecord() &&
          request.resource.data.empresaId == empresaId);
      allow update, delete: if isAdmin();
    }

    match /registrotiempos/{empresaId}/records/{recordId} {
      allow read: if hasRegistroTiemposPermission();
      allow create: if hasRegistroTiemposPermission() &&
        isRegistroTiemposRecord() &&
        request.resource.data.empresaId == empresaId;
      allow update, delete: if isAdmin();
    }

    match /proveedores/{empresaId} {
      allow read, write: if isSignedIn() || isCompatWindow();

      match /items/{providerCode} {
        allow read, write: if isSignedIn() || isCompatWindow();
      }
    }

    match /MovimientosFondos/{docId} {
      allow read, write: if isSignedIn() || isCompatWindow();

      match /movements/{movementId} {
        allow read, write: if isSignedIn() || isCompatWindow();
      }

      match /cajanegra/{movementId} {
        allow read, write: if isSignedIn() || isCompatWindow();
      }

      match /tucan/{movementId} {
        allow read, write: if isSignedIn() || isCompatWindow();
      }

      match /tiempos/{movementId} {
        allow read, write: if hasTiemposPermission();
      }
    }

    function internalDebtUserPartyKey() {
      return 'user:' + request.auth.uid;
    }

    function isInternalDebtParticipant(data) {
      return isSignedIn() &&
        data.participantIds is list &&
        internalDebtUserPartyKey() in data.participantIds;
    }

    function isInternalDebtOwnerScopedAdmin(data) {
      return isRegularAdmin() &&
        data.ownerId is string &&
        (
          (request.auth.token.ownerId is string &&
            data.ownerId == request.auth.token.ownerId) ||
          (request.auth.token.eliminate == false &&
            data.ownerId == request.auth.uid)
        );
    }

    function isInternalDebtEmpresaPartyForActor(party) {
      return party.type == 'empresa' &&
        request.auth.token.ownercompanie is string &&
        (party.id == request.auth.token.ownercompanie ||
          party.name == request.auth.token.ownercompanie);
    }

    function isInternalDebtUserOrCompanyDebt(data) {
      return data.debtor is map &&
        data.creditor is map &&
        (data.debtor.type == 'empresa' || data.debtor.type == 'user') &&
        (data.creditor.type == 'empresa' || data.creditor.type == 'user');
    }

    function canActAsInternalDebtParty(party, data) {
      return (party.type == 'user' && party.id == request.auth.uid) ||
        isInternalDebtEmpresaPartyForActor(party) ||
        (party.type != 'user' &&
          party.type != 'empresa' &&
          isInternalDebtParticipant(data));
    }

    function hasInternalDebtsPermission() {
      return isSignedIn() &&
        (
          isAdmin() ||
          get(/databases/$(database)/documents/users/$(request.auth.uid))
            .data.permissions.deudasInternas == true ||
          request.auth.token.deudasInternas == true ||
          (
            request.auth.token.permissions is map &&
            request.auth.token.permissions.deudasInternas == true
          )
        );
    }

    function hasInternalDebtBaseShape(data) {
      return data.keys().hasAll([
          'ownerId',
          'debtor',
          'creditor',
          'participantIds',
          'amountOriginal',
          'balance',
          'reason',
          'date',
          'status',
          'movements',
          'createdAt',
          'updatedAt',
          'createdById',
          'createdByName'
        ]) &&
        data.ownerId is string &&
        data.debtor is map &&
        data.creditor is map &&
        data.participantIds is list &&
        data.amountOriginal is number &&
        data.balance is number &&
        data.reason is string &&
        data.date is string &&
        (data.status == 'open' || data.status == 'paid') &&
        data.movements is list &&
        data.createdById == request.auth.uid;
    }

    function nextInternalDebtMovement() {
      return request.resource.data.movements[resource.data.movements.size()];
    }

    function hasInternalDebtMovementShape(movement) {
      return movement.keys().hasOnly([
          'id',
          'type',
          'amount',
          'reason',
          'reference',
          'date',
          'createdAt',
          'createdById',
          'createdByName'
        ]) &&
        movement.keys().hasAll([
          'id',
          'type',
          'amount',
          'reason',
          'date',
          'createdAt',
          'createdById',
          'createdByName'
        ]) &&
        movement.id is string &&
        (movement.type == 'charge' || movement.type == 'payment') &&
        movement.amount is number &&
        movement.amount > 0 &&
        movement.reason is string &&
        movement.date is string &&
        movement.createdAt is timestamp &&
        movement.createdById == request.auth.uid &&
        movement.createdByName is string &&
        (!movement.keys().hasAny(['reference']) || movement.reference is string);
    }

    function hasValidInternalDebtMovementAppend() {
      return request.resource.data.movements.size() == resource.data.movements.size() + 1 &&
        hasInternalDebtMovementShape(nextInternalDebtMovement()) &&
        isInternalDebtMovementRoleAllowed() &&
        (
          (
            nextInternalDebtMovement().type == 'payment' &&
            nextInternalDebtMovement().amount <= resource.data.balance &&
            request.resource.data.balance == resource.data.balance - nextInternalDebtMovement().amount &&
            (
              (nextInternalDebtMovement().amount == resource.data.balance &&
                request.resource.data.status == 'paid') ||
              (nextInternalDebtMovement().amount < resource.data.balance &&
                request.resource.data.status == 'open')
            )
          ) ||
          (
            nextInternalDebtMovement().type == 'charge' &&
            request.resource.data.balance == resource.data.balance + nextInternalDebtMovement().amount &&
            request.resource.data.status == 'open'
          )
        );
    }

    function isInternalDebtMovementRoleAllowed() {
      return isSuperAdmin() ||
        (
          nextInternalDebtMovement().type == 'payment' &&
          canActAsInternalDebtParty(resource.data.creditor, resource.data)
        ) ||
        (
          nextInternalDebtMovement().type == 'charge' &&
          canActAsInternalDebtParty(resource.data.debtor, resource.data)
        );
    }

    match /internalDebts/{debtId} {
      allow read: if hasInternalDebtsPermission() &&
        (
          isInternalDebtParticipant(resource.data) ||
          isSuperAdmin() ||
          (
            isInternalDebtOwnerScopedAdmin(resource.data) &&
            isInternalDebtUserOrCompanyDebt(resource.data)
          )
        );
      allow create: if hasInternalDebtsPermission() &&
        hasInternalDebtBaseShape(request.resource.data) &&
        isInternalDebtParticipant(request.resource.data);
      allow update: if hasInternalDebtsPermission() &&
        (
          isInternalDebtParticipant(resource.data) ||
          isSuperAdmin() ||
          canActAsInternalDebtParty(resource.data.debtor, resource.data) ||
          canActAsInternalDebtParty(resource.data.creditor, resource.data)
        ) &&
        resource.data.status != 'paid' &&
        resource.data.balance > 0 &&
        request.resource.data.ownerId == resource.data.ownerId &&
        request.resource.data.debtor == resource.data.debtor &&
        request.resource.data.creditor == resource.data.creditor &&
        request.resource.data.participantIds == resource.data.participantIds &&
        request.resource.data.amountOriginal == resource.data.amountOriginal &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdById == resource.data.createdById &&
        request.resource.data.updatedAt is timestamp &&
        hasValidInternalDebtMovementAppend() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['balance', 'status', 'movements', 'updatedAt']);
      allow delete: if isSuperAdmin();
    }

    function isPrimaryAdminOwner(ownerId) {
      return isRegularAdmin() &&
        request.auth.token.eliminate == false &&
        request.auth.uid == ownerId;
    }

    function isOwnerChatMember(ownerId) {
      return isSignedIn() &&
        (request.auth.token.role == 'admin' ||
          request.auth.token.role == 'user') &&
        (
          isPrimaryAdminOwner(ownerId) ||
          (
            request.auth.token.ownerId is string &&
            request.auth.token.ownerId == ownerId
          )
        );
    }

    function canReadOwnerChat(ownerId) {
      return isSuperAdmin() || isOwnerChatMember(ownerId);
    }

    function hasOwnerChatMessageShape(ownerId) {
      return request.resource.data.keys().hasOnly([
          'ownerId',
          'senderId',
          'senderName',
          'senderRole',
          'senderScheduleCompany',
          'senderScheduleManager',
          'text',
          'createdAt'
        ]) &&
        request.resource.data.keys().hasAll([
          'ownerId',
          'senderId',
          'senderName',
          'senderRole',
          'text',
          'createdAt'
        ]) &&
        request.resource.data.ownerId == ownerId &&
        request.resource.data.senderId == request.auth.uid &&
        request.resource.data.senderName is string &&
        request.resource.data.senderName.size() > 0 &&
        request.resource.data.senderRole == request.auth.token.role &&
        (
          request.resource.data.senderRole == 'admin' ||
          request.resource.data.senderRole == 'user' ||
          request.resource.data.senderRole == 'superadmin'
        ) &&
        (!request.resource.data.keys().hasAny([
            'senderScheduleCompany',
            'senderScheduleManager'
          ]) ||
          (
            request.resource.data.senderRole == 'user' &&
            request.resource.data.keys().hasAll([
              'senderScheduleCompany',
              'senderScheduleManager'
            ]) &&
            request.resource.data.senderScheduleCompany is string &&
            request.resource.data.senderScheduleCompany.size() > 0 &&
            request.resource.data.senderScheduleCompany.size() <= 160 &&
            request.resource.data.senderScheduleManager is string &&
            request.resource.data.senderScheduleManager.size() > 0 &&
            request.resource.data.senderScheduleManager.size() <= 120
          )) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 2000 &&
        request.resource.data.createdAt is timestamp;
    }

    function hasOwnerChatReadShape(ownerId, userId) {
      return request.resource.data.keys().hasOnly([
          'ownerId',
          'userId',
          'userName',
          'muted',
          'lastReadAt',
          'updatedAt'
        ]) &&
        request.resource.data.ownerId == ownerId &&
        request.resource.data.userId == userId &&
        (!request.resource.data.keys().hasAny(['userName']) ||
          request.resource.data.userName is string) &&
        (!request.resource.data.keys().hasAny(['muted']) ||
          request.resource.data.muted is bool) &&
        (!request.resource.data.keys().hasAny(['lastReadAt']) ||
          request.resource.data.lastReadAt is timestamp) &&
        (!request.resource.data.keys().hasAny(['updatedAt']) ||
          request.resource.data.updatedAt is timestamp);
    }

    match /ownerChats/{ownerId} {
      allow read: if canReadOwnerChat(ownerId);
      allow create, update: if false;
      allow delete: if isSuperAdmin();

      match /messages/{messageId} {
        allow read: if canReadOwnerChat(ownerId);
        allow create: if (isSuperAdmin() || isOwnerChatMember(ownerId)) &&
          hasOwnerChatMessageShape(ownerId);
        allow update, delete: if false;
      }

      match /reads/{userId} {
        allow read: if canReadOwnerChat(ownerId) &&
          (userId == request.auth.uid || isSuperAdmin());
        allow create, update: if canReadOwnerChat(ownerId) &&
          userId == request.auth.uid &&
          hasOwnerChatReadShape(ownerId, userId);
        allow delete: if canReadOwnerChat(ownerId) &&
          (userId == request.auth.uid || isSuperAdmin());
      }
    }

    // Gente Crystal integration data is server-only. Route Handlers use
    // Firebase Admin and are not affected by client security rules.
    match /genteCrystalIntegrationDevices/{document=**} {
      allow read, write: if false;
    }

    match /genteCrystalSales/{document=**} {
      allow read, write: if false;
    }

    // Gmail OAuth, watch checkpoints and webhook jobs are server-only.
    match /gmailIntegrations/{document=**} {
      allow read, write: if false;
    }

    match /gmailAccountMappings/{document=**} {
      allow read, write: if false;
    }

    match /gmailWatches/{document=**} {
      allow read, write: if false;
    }

    match /gmailWebhookJobs/{document=**} {
      allow read, write: if false;
    }

    match /sinpeRealtimeSessions/{document=**} {
      allow read, write: if false;
    }

    // Realtime SINPE events are immutable from clients and scoped by company.
    match /sinpeEvents/{empresaId} {
      allow read, write: if false;

      match /events/{eventId} {
        allow read: if canReadSinpeRealtime(empresaId);
        allow create, update, delete: if false;
      }
    }

    // Each user can observe their own preference so active sessions stay in
    // sync. Writes remain server-only through the authenticated route.
    match /sinpeNotificationPreferences/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    // Retired integration collections remain blocked in case historical data
    // still exists. No client or Route Handler consumes these collections.
    match /bcrIntegrationDevices/{document=**} {
      allow read, write: if false;
    }

    match /bcrReceipts/{document=**} {
      allow read, write: if false;
    }

    // WebAuthn credentials, one-time ceremonies and app sessions are
    // exclusively managed by server Route Handlers through Firebase Admin.
    match /passkeyUsers/{document=**} {
      allow read, write: if false;
    }

    match /passkeys/{document=**} {
      allow read, write: if false;
    }

    match /webauthnCeremonies/{document=**} {
      allow read, write: if false;
    }

    match /passkeyEnrollmentGrants/{document=**} {
      allow read, write: if false;
    }

    match /authSessions/{document=**} {
      allow read, write: if false;
    }

    // TOTP, auditoria y rate limits contienen secretos o controles de acceso.
    // Solo Route Handlers con Firebase Admin pueden usarlos.
    match /totpSecrets/{document=**} {
      allow read, write: if false;
    }

    match /maintenanceAccessLogs/{document=**} {
      allow read, write: if false;
    }

    match /maintenanceRateLimits/{document=**} {
      allow read, write: if false;
    }

    // El perfil es fuente de verdad para emitir el claim role. Sacarlo del
    // catch-all evita que un usuario ordinario se promueva a Superadmin.
    function isKnownUserRole(role) {
      return role in ['user', 'admin', 'superadmin'];
    }

    function isOwnedByRegularAdmin(data) {
      let ownerId = data.get('ownerId', '');
      return isRegularAdmin() &&
        ownerId is string &&
        (
          ownerId == request.auth.uid ||
          (
            request.auth.token.get('ownerId', '') != '' &&
            ownerId == request.auth.token.get('ownerId', '')
          )
        );
    }

    function selfProfileKeepsAuthorizationFields() {
      return request.resource.data.get('role', 'user') ==
          resource.data.get('role', 'user') &&
        request.resource.data.get('ownerId', '') ==
          resource.data.get('ownerId', '') &&
        request.resource.data.get('permissions', {}) ==
          resource.data.get('permissions', {}) &&
        request.resource.data.get('eliminate', false) ==
          resource.data.get('eliminate', false) &&
        request.resource.data.get('isActive', true) ==
          resource.data.get('isActive', true);
    }

    match /users/{userId} {
      // Se conserva el alcance de lectura actual porque varios flujos existentes
      // consultan usuarios para resolver propietarios y empresas.
      allow read: if isSignedIn() || isCompatWindow();
      allow create: if isSuperAdmin() ||
        (
          isOwnedByRegularAdmin(request.resource.data) &&
          isKnownUserRole(request.resource.data.get('role', 'user')) &&
          request.resource.data.get('role', 'user') != 'superadmin'
        ) ||
        isCompatWindow();
      allow update: if isSuperAdmin() ||
        (
          isOwnedByRegularAdmin(resource.data) &&
          isOwnedByRegularAdmin(request.resource.data) &&
          resource.data.get('role', 'user') != 'superadmin' &&
          request.resource.data.get('role', 'user') != 'superadmin'
        ) ||
        (
          isSignedIn() &&
          request.auth.uid == userId &&
          selfProfileKeepsAuthorizationFields()
        ) ||
        isCompatWindow();
      allow delete: if isSuperAdmin() ||
        (
          isOwnedByRegularAdmin(resource.data) &&
          resource.data.get('role', 'user') != 'superadmin' &&
          resource.data.get('eliminate', false) == true
        ) ||
        isCompatWindow();
    }

    match /reportes_movimientos/{reportId} {
      allow read: if hasFondoGeneralPermission();
      allow write: if false;
    }

    match /system_config/{documentId} {
      allow read: if documentId == 'seasonal_effects' && isAppSession();
      allow write: if documentId == 'seasonal_effects' &&
        isAppSession() &&
        request.auth.token.role == 'superadmin' &&
        isValidSeasonalEffects(request.resource.data);
    }

    // El detalle contiene movimientos financieros. Solo el servidor lo lee
    // despues de validar empresa, cuenta y permiso de la sesion.
    match /reportes_detalle/{document=**} {
      allow read, write: if false;
    }

    // Durante la ventana de compatibilidad este bloque tambien acepta clientes
    // sin firmar (mismo alcance que tenia el catch-all eliminado). Cubre
    // `mail`, `security_logs`, `email_change_codes`,
    // `recovery_tokens` y demas colecciones sin reglas propias. Tras la fecha
    // de corte queda inactivo.
    match /{collection}/{document=**} {
      allow read, write: if collection != 'system_config' &&
        (isSignedIn() || isCompatWindow()) &&
        collection != 'ownerChats' &&
        collection != 'MovimientosFondos' &&
        collection != 'registrotucan' &&
        collection != 'registrotiempos' &&
        collection != 'pendingInvoiceDeletionRequests' &&
        collection != 'Facturas' &&
        collection != 'anotaciones' &&
        collection != 'internalDebts' &&
        collection != 'genteCrystalIntegrationDevices' &&
        collection != 'genteCrystalSales' &&
        collection != 'gmailIntegrations' &&
        collection != 'gmailAccountMappings' &&
        collection != 'gmailWatches' &&
        collection != 'gmailWebhookJobs' &&
        collection != 'sinpeRealtimeSessions' &&
        collection != 'sinpeEvents' &&
        collection != 'sinpeNotificationPreferences' &&
        collection != 'bcrIntegrationDevices' &&
        collection != 'bcrReceipts' &&
        collection != 'passkeyUsers' &&
        collection != 'passkeys' &&
        collection != 'webauthnCeremonies' &&
        collection != 'passkeyEnrollmentGrants' &&
        collection != 'version' &&
        collection != 'authSessions' &&
        collection != 'totpSecrets' &&
        collection != 'maintenanceAccessLogs' &&
        collection != 'maintenanceRateLimits' &&
        collection != 'users' &&
        collection != 'systemAnnouncements' &&
        collection != 'publishedSystemAnnouncements' &&
        collection != 'reportes_movimientos' &&
        collection != 'reportes_detalle';
    }

    // NOTA: el cliente accede a Firestore con Firebase Auth (custom token de
    // `/api/auth/firebase-token` + `signInWithCustomToken`). Durante la ventana
    // de compatibilidad (`isCompatWindow`, hasta 2026-10-01) los clientes aun
    // sin firmar mantienen el acceso que tenian con el catch-all eliminado;
    // despues del corte todo exige sesion. No reintroducir un
    // `match /{document=**}` sin autenticacion permanente: las reglas se
    // combinan con OR y anularia todas las restricciones anteriores.
  }
}
